{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!_expo/|assets/|icons/|favicon\\.ico|metadata\\.json|manifest\\.webmanifest|sw\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
